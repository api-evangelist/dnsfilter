            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"report_type\": \"<string>\",\n  \"start_at\": \"<string>\",\n  \"end_at\": \"<string>\",\n  \"cyber_sight_csv_export\": {\n    \"included_columns\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"organization_ids\": [\n      \"<integer>\",\n      \"<integer>\"\n    ]\n  },\n  \"ai_tool\": \"<string>\",\n  \"msp_uuid\": \"<string>\",\n  \"org_uuids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"excluded_org_uuids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"category_ids\": \"<string>\",\n  \"user_agent_uuids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"agent_local_user_uuids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"weekdays_only\": \"<boolean>\",\n  \"search_id\": \"<string>\",\n  \"size\": \"<integer>\",\n  \"activity_type_ids\": [\n    \"<integer>\",\n    \"<integer>\"\n  ],\n  \"app_executable_path\": \"<string>\",\n  \"app_name\": \"<string>\",\n  \"app_window_title\": \"<string>\",\n  \"web_full_url\": \"<string>\",\n  \"web_host\": \"<string>\",\n  \"threats_only\": \"<boolean>\",\n  \"web_categories\": \"<string>\",\n  \"sort_by\": \"<string>\",\n  \"sort_direction\": \"<string>\"\n}",
              "options": {
