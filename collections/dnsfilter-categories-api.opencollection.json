          "http": {
            "method": "GET",
            "url": "https://api.dnsfilter.com/v1/categories",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number and size"
              }
            ]
          },
          "docs": "List categories basic information."
        },
        {
          "info": {
            "name": "Get all",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dnsfilter.com/v1/categories/all",
