                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number and size"
              }
            ]
          },
          "docs": "List all categories including internal categories."
        },
        {
          "info": {
            "name": "Show category",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dnsfilter.com/v1/categories/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Category ID"
