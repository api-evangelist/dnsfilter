            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "query",
                "description": "The ID of the organization to get the redirection link for"
              },
              {
                "name": "psa_name",
                "value": "",
                "type": "query",
                "description": "The name of the PSA to be integrated with"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new PSA integration, if one does not exist and returns the redirect link."
        }
      ]
    }
  ],
  "bundled": true
